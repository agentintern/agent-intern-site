{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-intern",
  "pages_build_output_dir": "dist",
  "compatibility_date": "2026-10-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-intern",
